export function randomName(gender: '女' | '男'): string {
  const regionEntries = Object.entries(NAME_REGIONS);
  const [regionKey, region] = pick(regionEntries);
  const surname = pick(region.surnames);
  const name = gender === '女' ? pick(region.names_female) : pick(region.names_male);
  // 西系姓名用空格分隔（First Last 顺序：name + ' ' + surname）
  return regionKey === '西系' ? `${name} ${surname}` : surname + name;
}

