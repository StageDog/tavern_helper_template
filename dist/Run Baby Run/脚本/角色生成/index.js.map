export function randomMaleDress(): string {
  const pools = [DRESS_MALE_GLAMOROUS, DRESS_MALE_BODYSUIT, DRESS_MALE_MYSTIC, DRESS_MALE_FAIRY_TALE];
  const selectedPool = pools[Math.floor(Math.random() * pools.length)];
  return pick(selectedPool);
}
